            "initiationType": "tender",
            "tender": {
                "id": "MT238639",
                "title": "Smart Meter Programme Strategic Assessment",
                "description": "Ofgem requires a specialist strategic and technical support to assess the future trajectory and challenges of the smart meter programme and identify the priorities that should guide its work over the next 3-5 years, including action to be prioritised in the next 12-18 months.\r\nThe smart meter programme is entering a more complex and mature phase, shifting from first-time installations towards a greater focus on replacement, asset lifecycle management, complex technology transitions, reliable operation, and reaching consumers and premises not yet successfully served. The assessment should bring together the latest forecasts from energy suppliers' Deployment Plans, operational and market evidence, industry insight, consumer perspectives, and the wider policy and regulatory context.",
                "status": "complete",
                "classification": {
                    "scheme": "CPV",
                    "id": "79411000",
                    "description": "General management consultancy services"
                },
                "additionalClassifications": [
                    {
